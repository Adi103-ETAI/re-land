# ── LANDLENS backend (FastAPI + OCR) ────────────────────────────────────
# Build:  docker build -f Dockerfile.backend -t landlens-api .
# Run:    docker run -p 8000:8000 landlens-api

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Tesseract runtime + traineddata (eng guaranteed; mar/hin for Marathi/Hindi OCR)
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-mar \
        tesseract-ocr-hin \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY alembic.ini ./
COPY scripts ./scripts

# Non-root runtime user; data dir persists uploads + SQLite DB
RUN useradd --create-home --uid 1000 landlens \
    && mkdir -p /app/data/uploads \
    && chown -R landlens:landlens /app
USER landlens

ENV DATA_DIR=/app/data

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
