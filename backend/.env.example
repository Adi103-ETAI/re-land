# LANDLENS backend — copy to .env and adjust
# Database (default: local SQLite, zero setup)
# DATABASE_URL=postgresql://landlens:secret@localhost:5432/landlens

# OCR language chain (falls back to installed traineddata automatically)
OCR_LANG_CHAIN=mar+hin+eng

# Careful extraction thresholds
CONF_THRESHOLD=0.90
AUTO_APPROVE_SCORE=90

# Optional VLM fallback for handwriting (Gemini / Sarvam / ...)
# VLM_PROVIDER=gemini
# VLM_API_KEY=
# ENABLE_VLM=false
