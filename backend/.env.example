# ── LANDLENS backend — copy to .env and adjust ──────────────────────────

# Database: leave unset for zero-config local SQLite (backend/data/landlens.db).
# Production example: postgresql+asyncpg://landlens:secret@db:5432/landlens
# DATABASE_URL=

# CORS: comma-separated origins the API will accept browser requests from.
# Local dev default is "*"; set explicitly in production, e.g.
# CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to an empty value to hide the interactive API docs in production.
# DOCS_URL=/docs

# ── AI extraction ───────────────────────────────────────────────────────
# Provider: gemini | sarvam | openrouter | huggingface | groq | together | replicate
VLM_PROVIDER=gemini
VLM_API_KEY=
VLM_MODEL=
# false = skip VLM calls entirely (pure local OCR + rules)
ENABLE_VLM=true

# OCR language preference chain (engine intersects with installed traineddata)
OCR_LANG_CHAIN=mar+hin+eng

# ── Validation thresholds ───────────────────────────────────────────────
CONF_THRESHOLD=0.90
AUTO_APPROVE_SCORE=90

# ── Optional object storage (S3 / MinIO) ────────────────────────────────
S3_BUCKET=landlens-raw
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional Redis (job queue offload; SQLite queue used otherwise)
# REDIS_URL=redis://localhost:6379/0
