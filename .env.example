# ── Frontend (Next.js) ─────────────────────────────────────────────
# Base URL the browser client uses for auth calls.
# Leave unset to use the built-in Next.js API proxies (/api/*).
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-side proxy target: where Next.js forwards API calls.
# BACKEND_URL=http://localhost:8000

# ── Backend (FastAPI) ──────────────────────────────────────────────
# SQLite by default (zero setup). For production use PostgreSQL:
# DATABASE_URL=postgresql://landlens:secret@localhost:5432/landlens
DATABASE_URL=sqlite:///./landlens.db

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=/tmp/landlens-uploads

# ── AI extraction (optional) ───────────────────────────────────────
# ENABLE_VLM=true
# VLM_PROVIDER=gemini
# VLM_API_KEY=
# VLM_MODEL=gemini-3.5-flash

# ── Infrastructure (optional / docker-compose) ─────────────────────
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=landlens-uploads
