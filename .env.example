# ────────────────────────────────────────────────────────────────
# LANDLENS — Frontend environment (Next.js)
# Copy this file to .env.local and fill in your Supabase values.
# Supabase Dashboard → Project Settings → API
# ────────────────────────────────────────────────────────────────

# REQUIRED — Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED — Supabase anon/public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Extraction pipeline (FastAPI) ────────────────────────────────
# Base URL the browser client uses for pipeline calls.
# Leave unset to use the built-in Next.js API proxies (/api/*).
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-side proxy target: where Next.js forwards pipeline calls.
# BACKEND_URL=http://localhost:8000
