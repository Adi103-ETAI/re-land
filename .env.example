# ── LANDLENS frontend — copy to .env.local (dev) or .env (build) ────────

# Server-side proxy target for /api/v1/*, /api/upload and /api/jobs/[jobId].
# Auth and data calls ride the same origin — no CORS needed. Defaults to
# http://localhost:8000 when unset.
BACKEND_URL=http://localhost:8000

# Optional: make the BROWSER call the FastAPI backend directly instead of
# the same-origin proxy (inlined into the client bundle at build time).
# NEXT_PUBLIC_API_URL=

# ── Optional: Supabase (auth fallback + profiles) ───────────────────────
# When set (and the backend is unreachable) the app falls back to Supabase.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
